# Домены — в /opt/rizzoma/proxy/.env. Сертификат подставляет tls.caddy:
# до первого выпуска там самоподписанный (tls internal), потом файлы lego.
(cert) {
	import /etc/caddy/tls.caddy
}

{$PROD_DOMAIN} {
	import cert
	reverse_proxy prod-web:80
}

{$QA_DOMAIN} {
	import cert
	reverse_proxy qa-web:80
}

{$DEV_DOMAIN} {
	import cert
	reverse_proxy dev-web:80
}
