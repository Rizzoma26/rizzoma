# Общий вход: Caddy с DNS-плагином DuckDNS. Сертификат выпускается через TXT-запись
# (DNS-01): HTTP-проверка Let's Encrypt снаружи до сервера не доходит.
FROM caddy:2-builder AS build
RUN xcaddy build --with github.com/caddy-dns/duckdns

FROM caddy:2-alpine
COPY --from=build /usr/bin/caddy /usr/bin/caddy
