# Скопируйте в .env. Реальные секреты не коммитятся.
POSTGRES_DB=rizzoma
POSTGRES_USER=rizzoma
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://rizzoma:replace-with-a-long-random-password@postgres:5432/rizzoma

BOT_TOKEN=123456789:replace-with-real-token
APP_URL=https://rizzoma.example/
ALLOWED_ORIGINS=https://rizzoma.example,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:4321,http://localhost:4321
BOT_CORS_ORIGIN=https://rizzoma.example

WEB_PORT=8080
API_PORT=8081
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
SESSION_TTL_SECONDS=900
TRUST_PROXY_HOPS=1

# Текущие возможности бота. Пустые цены отключают оплату.
PROVIDER_TOKEN=
CURRENCY=RUB
PRICE_STD=
PRICE_VIP=
ADMIN_TG_IDS=
CHANNEL_ID=
DISCUSSION_ID=
BETA_OPEN=
RIZZOMA_BOT_USERNAME=
RIZZOMA_APP_SHORT_NAME=
