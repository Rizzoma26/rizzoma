NODE_ENV=development
APP_ENV=dev
DEV_ALLOWED_TG_IDS=
PORT=8081
DATABASE_URL=postgresql://rizzoma:rizzoma@127.0.0.1:5432/rizzoma
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000

BOT_TOKEN=123456789:replace-with-real-token
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
SESSION_TTL_SECONDS=900
# Exact HTTPS origin of the dev reverse proxy; required even in local API mode.
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0
