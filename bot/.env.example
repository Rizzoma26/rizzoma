# ============================================================

APP_ENV=dev
DEV_ALLOWED_TG_IDS=
QA_ENABLED=false
PAYMENT_MODE=disabled
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
# Секреты бэкенда. Этот файл — только пример, .env в git не попадает.
# В бою значения живут в переменных окружения хостинга, не в файлах.
# ============================================================

# Токен бота из @BotFather (/newbot или /token).
# Для беты заведи ОТДЕЛЬНОГО бота — продовый не трогай.
BOT_TOKEN=123456:AA...

# HTTPS-адрес bootstrap своего контура (через nginx с session gate).
APP_URL=

# Внутренний URL TypeScript API. Для локального запуска вне Compose
# замените на http://127.0.0.1:8081.
REGISTRATION_API_BASE=http://api:8081

# Тот же PostgreSQL, что использует API: оплаты, баллы и настройки беты.
# Локально вне Compose замените postgres на 127.0.0.1.
DATABASE_URL=postgresql://rizzoma:replace-with-password@postgres:5432/rizzoma

# Порт API
PORT=8080

# Единственный HTTPS origin контура, совпадает с origin APP_URL.
CORS_ORIGIN=

# ---------- платежи ----------
# Токен платёжного провайдера: @BotFather → /mybots → выбрать бота →
# Payments → провайдер (ЮKassa / Robokassa / CloudPayments) → Provider token.
# PAYMENT_MODE=test разрешён только в dev с токеном :TEST:.
# PAYMENT_MODE=live разрешён только в prod с токеном :LIVE:.
PROVIDER_TOKEN=

# Валюта счёта и цена ОДНОЙ проходки в рублях.
# Пусто — счёт не выставляется, приложение честно пишет «уточняется».
CURRENCY=RUB
PRICE_STD=
PRICE_VIP=

# ---------- активность в канале ----------
# Числовой id канала t.me/rizzoma26 (НЕ @username), например -1001234567890.
# Узнаётся один раз: добавить бота админом и вызвать getChat, либо посмотреть
# в любом апдейте из канала. Пусто — баллы не начисляются вообще: без явного
# id бот раздавал бы очки за реакции в любом чате, куда его позовут.
CHANNEL_ID=

# Привязанная к каналу группа обсуждений, если она есть. Пусто — комментарии
# просто не приходят, правило 'comment' не срабатывает, остальное работает.
DISCUSSION_ID=

# ---------- бета ----------
# Telegram user id администраторов беты через запятую. Только они
# открывают бета-админку. Пусто — не откроет никто.
# Свой id можно узнать у @userinfobot.
ADMIN_TG_IDS=

# Какие узлы дерева открыты тестерам (индексы TIERS 0…9 через запятую).
# Это настройка контура: /api/state отдаёт ровно этот список, в БД он не
# хранится и из админки не меняется — только деплоем (правка env и
# пересоздание бота). Для APP_ENV=dev и prod обязателен; нецелое, вне
# диапазона, пустой элемент, повтор или пустое значение останавливают бота
# с сообщением, что именно не так. Без APP_ENV (локальные тесты) пусто
# означает BETA_OPEN из economy.js: 0,1,3,4.
BETA_OPEN=0,1,3,4
