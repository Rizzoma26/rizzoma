# Copy outside Git, e.g. /etc/rizzoma/prod.env; chmod 600.
APP_ENV=prod
RELEASE_TAG=replace-with-verified-commit
WEB_PORT=8080
SERVICE_MEMORY_LIMIT=512m
SERVICE_CPUS=0.5
POSTGRES_DB=rizzoma_prod
POSTGRES_USER=rizzoma_prod
POSTGRES_PASSWORD=replace-with-unique-random-password
DATABASE_URL=postgresql://rizzoma_prod:replace-with-unique-random-password@postgres:5432/rizzoma_prod
BOT_TOKEN=replace-with-prod-bot-token
# Exact HTTPS origin, no trailing slash. Fill after domains are chosen.
APP_URL=
ALLOWED_ORIGINS=
BOT_CORS_ORIGIN=
# Required for dev. Comma-separated Telegram numeric user IDs.
DEV_ALLOWED_TG_IDS=
QA_ENABLED=false
# disabled by default; test only on dev, live only on prod.
PAYMENT_MODE=disabled
PROVIDER_TOKEN=
CURRENCY=RUB
PRICE_STD=
PRICE_VIP=
ADMIN_TG_IDS=
CHANNEL_ID=
DISCUSSION_ID=
# Required. Beta tiers open to testers in this contour (economy.js TIERS indexes
# 0-9, comma-separated). /api/state serves exactly this list; it is not stored in
# the database and changes only with a redeploy of the bot. The bot refuses to
# start on an empty or invalid list. 0,1,3,4 is derived from the economy.js
# default, NOT measured: before the first release without beta_settings run
# tools/beta-settings-capture.sh with this env file and keep the value it reports.
BETA_OPEN=0,1,3,4
RIZZOMA_BOT_USERNAME=
RIZZOMA_APP_SHORT_NAME=
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
SESSION_TTL_SECONDS=900
TRUST_PROXY_HOPS=1
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
